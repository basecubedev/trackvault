# TrackVault configuration.
#
# Copy to `.env` and edit. `.env` is git-ignored and must stay that way: it
# describes one deployment, and its import path alone says where somebody keeps
# their movement data.
#
# Every value here has a working default, so an empty file is a valid one. This
# lists what exists and what it means, which is the part a default cannot say.
#
# There are no secrets in TrackVault and none belong in this file. The archive has
# no accounts, no tokens and no API keys -- see "Security" in README.md for what
# it assumes instead.

# --- Where things live ---------------------------------------------------

# Everything persistent: the database, its journal files, every original import
# and any installed offline maps. Backing this up backs up the whole archive.
# In the container this is /data.
# TRACKVAULT_DATA_DIR=data

# Where `trackvault scan` looks for new files, for example a phone's sync target.
# Unset disables scanning entirely, which is why a deployment that mounts a
# folder and forgets this variable finds nothing. In the container this is
# /import, mounted read-only.
# TRACKVAULT_IMPORT_DIR=

# Where `trackvault backup create` writes. Defaults to `backups/` beside the data
# directory, deliberately not inside it: a backup kept in the directory it
# protects is lost with it. In the container this is /backups.
# TRACKVAULT_BACKUP_DIR=

# --- The interface -------------------------------------------------------

# The address the application itself binds. In the container this is
# 0.0.0.0:8080, which is also what the image's health check asks. The port a
# browser opens is the *published* one -- `TRACKVAULT_HTTP_PORT`, 8081 by default
# -- and Docker maps it onto 8080. Two ports, two settings, on purpose.
# TRACKVAULT_HOST=127.0.0.1
# TRACKVAULT_PORT=8080

# Which host port `compose.yaml` and the installer publish 8080 on. Change this
# when something else on the machine already has 8081.
# TRACKVAULT_HTTP_PORT=8081

# The built browser application. When it holds no index.html the server answers
# the API only, which is what a development run wants.
# TRACKVAULT_WEB_DIR=web/dist

# --- What the numbers mean -----------------------------------------------

# The IANA zone month and year boundaries are drawn in, for example
# Europe/Berlin. UTC by default, and deliberately not the host's zone: a
# container inherits whatever its image carries, so a local-time default would
# make the same archive report different monthly totals on two machines. An
# unknown zone fails at start-up rather than falling back silently.
# TRACKVAULT_TIMEZONE=UTC

# --- What this deployment permits ----------------------------------------

# Whether the browser interface may add files. Off unless you set it here.
# There is no authentication, so anyone who can reach the port could upload as
# well as read; switching this on is a statement that your network makes that
# acceptable. Every read works without it, and importing stays what it was --
# the command line and the watched folder, which is how Locus AutoSync works.
# TRACKVAULT_UPLOAD_ENABLED=true

# Whether offline map packages may be installed at all. Turning this off means
# no outbound request is ever made, not even a deliberate one. Maps that are
# already installed keep working.
# TRACKVAULT_MAPS_ENABLED=true

# The largest map package this deployment will fetch. A ceiling rather than a
# preference: an unbounded stream to a file is a way to fill a disk with one
# request.
# TRACKVAULT_MAP_MAX_DOWNLOAD_BYTES=

# --- Import limits -------------------------------------------------------
#
# These bound a hostile or broken file, not normal use. The defaults comfortably
# cover an ordinary long recording.

# TRACKVAULT_IMPORT_MAX_BYTES=16777216
# TRACKVAULT_IMPORT_MAX_TRACKS=100
# TRACKVAULT_IMPORT_MAX_SEGMENTS_PER_TRACK=1000
# TRACKVAULT_IMPORT_MAX_POINTS=500000
