<?xml version="1.0" encoding="UTF-8"?>
<gpx version="1.1" creator="SyntheticExporter"
     xmlns="http://www.topografix.com/GPX/1/1"
     xmlns:gpxtpx="http://www.garmin.com/xmlschemas/TrackPointExtension/v9">
  <trk>
    <name>Synthetic track using an unregistered track point schema</name>
    <trkseg>
      <trkpt lat="52.3000" lon="13.3000">
        <ele>60.0</ele>
        <time>2026-07-14T09:00:00Z</time>
        <extensions>
          <gpxtpx:TrackPointExtension>
            <gpxtpx:course>90.0</gpxtpx:course>
          </gpxtpx:TrackPointExtension>
        </extensions>
      </trkpt>
      <trkpt lat="52.3010" lon="13.3010">
        <ele>61.0</ele>
        <time>2026-07-14T09:01:00Z</time>
      </trkpt>
    </trkseg>
  </trk>
</gpx>
