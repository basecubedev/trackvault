# Python
__pycache__/
*.py[cod]
build/
dist/
*.egg-info/

# Environments and secrets
.venv/
venv/
.env

# Tooling caches and reports
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
junit*.xml

# Local agent/tool data
.serena/
.gitnexus/
.claude/skills/gitnexus/

# Editors and OS
.idea/
.vscode/
.DS_Store

# Local runtime data, bind-mounted into the container at /data
/data/

# Personal GPS recordings are private user data and must never be committed.
# Synthetic, explicitly cleared fixtures live under tests/fixtures/ and are exempt.
*.gpx
!tests/fixtures/**/*.gpx

# The deployment's import folder, bind-mounted read-only at /import. The folder
# itself is committed as an empty marker so a fresh checkout has it -- otherwise
# Docker creates it, owned by root, and the person it exists for cannot drop a
# file into it. Everything anybody puts in it is private movement data.
/import/*
!/import/.gitkeep

# Backups hold every recording and every correction the archive has: personal
# data in one file. A user deployment keeps them in ./backups beside the
# compose file, so the pattern is here whether or not this checkout has one.
/backups/

# Local reference tracks: real private recordings and routes a developer may keep
# here for exploration and local regression runs. The whole directory is excluded,
# not just the extensions we happen to know today, so a sidecar file, an export
# note or a future FIT recording cannot slip in either. The suite never requires
# this directory to exist.
/import-tracks/

# Frontend build output, browser caches and browser-test artefacts.
/web/node_modules/
/web/dist/
/web/playwright-report/
/web/test-results/
